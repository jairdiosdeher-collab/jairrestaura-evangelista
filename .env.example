# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# In Vercel / GitHub deployments, configure GEMINI_API_KEY in Vercel Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional URL where this applet is hosted.
APP_URL="MY_APP_URL"
